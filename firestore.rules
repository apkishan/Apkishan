rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default-Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // --- REUSABLE SECURITY PRIMITIVES ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- ENTITY SCHEMA VALIDATIONS (THE 'ANTI-UPDATE-GAP') ---

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'displayName', 'phoneNumber', 'onlineStatus', 'lastSeen'])
        && data.keys().size() <= 9
        && data.uid is string
        && data.uid.size() <= 128
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 100
        && data.phoneNumber is string
        && data.phoneNumber.size() >= 10
        && data.phoneNumber.size() <= 15
        && (data.onlineStatus == 'online' || data.onlineStatus == 'offline')
        && (!data.keys().hasAny(['email']) || (data.email is string && data.email.size() <= 120))
        && (!data.keys().hasAny(['avatarUrl']) || (data.avatarUrl is string && data.avatarUrl.size() <= 2084))
        && (!data.keys().hasAny(['statusMessage']) || (data.statusMessage is string && data.statusMessage.size() <= 280))
        && (!data.keys().hasAny(['primaryLanguage']) || (data.primaryLanguage in ['English', 'Hindi', 'Bengali', 'Tamil', 'Telugu']));
    }

    function isValidChatRoom(data) {
      return data.keys().hasAll(['id', 'type', 'members', 'lastMessageAt'])
        && data.keys().size() <= 6
        && data.id is string
        && (data.type == 'one-to-one' || data.type == 'group')
        && data.members is list
        && data.members.size() >= 1
        && data.members.size() <= 100
        && (!data.keys().hasAny(['name']) || (data.name is string && data.name.size() <= 120))
        && (!data.keys().hasAny(['lastMessageText']) || (data.lastMessageText is string && data.lastMessageText.size() <= 1000));
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['id', 'senderId', 'senderName', 'text', 'type', 'createdAt'])
        && data.keys().size() <= 9
        && data.id is string
        && data.senderId is string
        && data.senderId == request.auth.uid // Identity Protection
        && data.senderName is string
        && data.senderName.size() <= 100
        && data.text is string
        && data.text.size() <= 5000
        && (data.type in ['text', 'image', 'video', 'audio', 'document'])
        && (!data.keys().hasAny(['fileUrl']) || (data.fileUrl is string && data.fileUrl.size() <= 2084))
        && (!data.keys().hasAny(['reactions']) || data.reactions is map)
        && (!data.keys().hasAny(['seenBy']) || (data.seenBy is list && data.seenBy.size() <= 100));
    }

    function isValidCallHistory(data) {
      return data.keys().hasAll(['id', 'hostId', 'type', 'isGroup', 'participants', 'status', 'startTime'])
        && data.keys().size() <= 9
        && data.id is string
        && data.hostId is string
        && (data.type == 'video' || data.type == 'voice')
        && data.isGroup is bool
        && data.participants is list
        && data.participants.size() >= 1
        && data.participants.size() <= 100
        && (data.status in ['missed', 'completed', 'ongoing'])
        && (!data.keys().hasAny(['durationSeconds']) || data.durationSeconds is int)
        && (!data.keys().hasAny(['aiSummary']) || (data.aiSummary is string && data.aiSummary.size() <= 10000));
    }

    // --- COLLECTION PATH MATCHING RULES ---

    // 1. User Profiles
    match /users/{userId} {
      allow read: if isSignedIn(); // Allow reading contact list
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && isValidUser(incoming())
        && incoming().uid == existing().uid // Immortal field check 
        && (
          // Action: Modify profile
          incoming().diff(existing()).affectedKeys().hasAny(['displayName', 'avatarUrl', 'statusMessage', 'primaryLanguage', 'onlineStatus', 'lastSeen'])
        );
      allow delete: if isOwner(userId);
    }

    // 2. Chat Rooms
    match /chats/{chatId} {
      // Must be a member of the chat to read it
      allow read: if isSignedIn() && (request.auth.uid in resource.data.members);
      allow create: if isSignedIn() && isValidId(chatId) && isValidChatRoom(incoming())
        && (request.auth.uid in incoming().members);
      allow update: if isSignedIn() && (request.auth.uid in existing().members) && isValidChatRoom(incoming())
        && incoming().id == existing().id // Immutable
        && (
          // Action: Update typing / last message / add members
          incoming().diff(existing()).affectedKeys().hasAny(['members', 'lastMessageText', 'lastMessageAt', 'name'])
        );
      // Delete only allowed for groups if owner or simple one-one if member
      allow delete: if isSignedIn() && (request.auth.uid in existing().members);

      // 3. Nested Chat Messages (Subcollection)
      match /messages/{messageId} {
        // Enforce parent check: Must be a member of the parent ChatRoom to read/write messages
        allow read: if isSignedIn() && (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members);
        allow create: if isSignedIn() && isValidId(messageId) && isValidMessage(incoming())
          && (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members);
        allow update: if isSignedIn() && (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members)
          && isValidMessage(incoming())
          && incoming().id == existing().id // Immutable ID
          && incoming().senderId == existing().senderId // Immutable Sender
          && (
            // Action 1: Add Reaction (anyone in chat can react)
            incoming().diff(existing()).affectedKeys().hasOnly(['reactions']) ||
            // Action 2: Update read status
            incoming().diff(existing()).affectedKeys().hasOnly(['seenBy']) ||
            // Action 3: Edit message (only original sender can edit text)
            (existing().senderId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['text']))
          );
        allow delete: if isSignedIn() && (existing().senderId == request.auth.uid);
      }
    }

    // 4. Call History Logs
    match /calls/{callId} {
      allow read: if isSignedIn() && (request.auth.uid in resource.data.participants);
      allow create: if isSignedIn() && isValidId(callId) && isValidCallHistory(incoming())
        && (request.auth.uid in incoming().participants);
      allow update: if isSignedIn() && (request.auth.uid in existing().participants) && isValidCallHistory(incoming())
        && incoming().id == existing().id // Immutable ID
        && (
          // Action: End call / upload duration and summaries
          incoming().diff(existing()).affectedKeys().hasAny(['status', 'durationSeconds', 'aiSummary'])
        );
      allow delete: if isSignedIn() && (request.auth.uid == existing().hostId);
    }
  }
}
